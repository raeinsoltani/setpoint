{
  "title": "setpoint — live demo",
  "uid": "setpoint-demo",
  "tags": [
    "setpoint",
    "demo"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": true,
  "refresh": "5s",
  "time": {
    "from": "now-10m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 2
      },
      {
        "name": "rate",
        "description": "The demo's constant offered load, req/s. Matches RATE in demo.sh.",
        "type": "constant",
        "query": "550",
        "hide": 2
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "controller restarted",
        "description": "Every act restarts the controller with a new config; a new pod's series appearing marks the boundary.",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "enable": true,
        "iconColor": "#8E8E8E",
        "expr": "count by (pod) (autoscaler_reconcile_total) unless count by (pod) (autoscaler_reconcile_total offset 15s)",
        "step": "15s",
        "titleFormat": "act change",
        "useValueForTime": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Pods",
      "description": "Ready pods against the correct fleet for the constant load (ceil(550 / 100) = 6). The dashed line is the policy's raw recommendation; where it parts from the requested line, the stabilizer is overriding the policy.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 11,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 20,
          "decimals": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "lineInterpolation": "stepAfter",
            "axisSoftMax": 12
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "ready pods"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#1F60C4"
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 5
              },
              {
                "id": "custom.fillOpacity",
                "value": 12
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "requested"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#5A6B7B"
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "policy's raw recommendation"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#FF9830"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "dash": [
                    10,
                    6
                  ],
                  "fill": "dash"
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "correct fleet (550 / 100)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#37872D"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "dash": [
                    2,
                    6
                  ],
                  "fill": "dot"
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 2
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(autoscaler_ready_replicas)",
          "legendFormat": "ready pods"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(autoscaler_desired_replicas)",
          "legendFormat": "requested"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(autoscaler_raw_recommendation)",
          "legendFormat": "policy's raw recommendation"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "ceil(vector($rate) / 100)",
          "legendFormat": "correct fleet (550 / 100)"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Load per pod — what the controller measures",
      "description": "The controller's own reading of requests/s per ready pod. The traffic is constant, so every swing here is the fleet size changing underneath it.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 11
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "decimals": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "lineInterpolation": "stepAfter",
            "axisSoftMax": 200
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "load per pod"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#1F60C4"
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 3
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "target (100)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#37872D"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "dash": [
                    2,
                    6
                  ],
                  "fill": "dot"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "SLA limit (110)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#C4162A"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "dash": [
                    10,
                    6
                  ],
                  "fill": "dash"
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 1
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(autoscaler_metric_value)",
          "legendFormat": "load per pod"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(autoscaler_metric_target)",
          "legendFormat": "target (100)"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(autoscaler_metric_target) * 1.1",
          "legendFormat": "SLA limit (110)"
        }
      ]
    }
  ]
}
