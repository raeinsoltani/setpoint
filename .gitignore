# University documents — deliberately untracked.
# The signed proposal carries handwritten signatures, a student ID and a university
# email; keeping these out of git means they cannot leak through history if this
# repository is ever pushed to a public remote. The files stay on disk, just untracked.
*.pdf
*.docx

# Python (simulator)
__pycache__/
.pytest_cache/
.venv/
*.pyc

# Go
autoscaler/bin/
*.test
*.out

# Experiment output — raw series are regenerated by experiments/run.sh.
# Note: sim/results/*.png IS tracked; those are the thesis fallback figures.
experiments/results/raw/

# macOS
.DS_Store
